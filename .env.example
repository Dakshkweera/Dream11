# Copy to .env.local and fill in. Never commit .env.local.

# OpenRouter — all AI goes through this one key (server-side only)
OPENROUTER_API_KEY=

# Neon Postgres connection string (https://neon.tech → New project → Connection string)
DATABASE_URL=

# Public URL of the app (sent to OpenRouter as HTTP-Referer)
APP_URL=http://localhost:3000

# Optional model overrides (defaults in src/lib/ai/models.ts)
# MODEL_STORY=anthropic/claude-haiku-5.5   # anthropic/claude-sonnet-5.5 for richer stories at 20x the cost
# MODEL_CHAT=anthropic/claude-haiku-5.5   # use claude-sonnet-5.5 for richer but slower chat
# MODEL_EXTRACT=anthropic/claude-haiku-5.5
# MODEL_VISION=google/gemini-3.8-flash
# MODEL_FALLBACK=google/gemini-3.8-flash
# MODEL_STT=openai/whisper-large-v3-turbo
# MODEL_TTS=google/gemini-3.8-flash-tts   # most natural Indian voice (Puck), ~3 s per line. Faster: microsoft/mai-voice-2.1-flash with TTS_VOICE=en-IN-AaravNeural
# TTS_VOICE=Puck   # Gemini voices: Puck, Kore, Fenrir, Aoede. Microsoft Indian voices: en-IN-AaravNeural, hi-IN-MadhurNeural, hi-IN-SwaraNeural
# How hard models think before answering: minimal | low | medium | high (default low; faster and cheaper)
# AI_EFFORT=low

# Force the local file store instead of Postgres (dev only)
# STORE=file

# Local dev only: resolve the database host through this DNS server if your network blocks Neon
# DNS_SERVERS=8.8.8.8

# Set to 0 to skip writing the story behind each nudge in the background (saves one AI call per nudge)
# PREGENERATE_STORIES=0

# Set to 0 to turn off web lookups for questions outside the IPL data (each costs about 1.5-3 cents)
# WEB_SEARCH=0

# Set to 0 to skip the web-research step before stories (saves about 1 cent per new topic)
# STORY_RESEARCH=0
